file(READ
    ${CMAKE_INSTALL_PREFIX}/lib/cmake/ldl-@LDL_VERSION@/LDLTargets.cmake
    LDL_TARGETS_CONTENT
)
string(REGEX REPLACE
    "set\\(_IMPORT_PREFIX \"[^\"]*\"\\)"
    "set(_IMPORT_PREFIX \"\${CMAKE_CURRENT_LIST_DIR}/../../..\")"
    LDL_TARGETS_CONTENT
    ${LDL_TARGETS_CONTENT}
)
file(WRITE
    ${CMAKE_INSTALL_PREFIX}/lib/cmake/ldl-@LDL_VERSION@/LDLTargets.cmake
    ${LDL_TARGETS_CONTENT}
)
